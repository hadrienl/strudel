// "Verre dépoli" — techno mélancolique — 132 BPM — Sol mineur
// Démo de validation de la chaîne : fichier .strudel → lien strudel.cc

setcpm(132/4)

const keys = x => x.s("sawtooth").attack(.01).decay(.25).sustain(.35).release(.4)
  .lpf(sine.rangex(600, 2400).slow(24)).lpq(6);

// batterie
$: s("bd*4").bank("RolandTR909").gain(.9).shape(.3).duck(1).duckdepth(.7)
$: s("~ ~ cp ~").bank("RolandTR909").room(.6).roomsize(4).gain(.5).orbit(1)
$: s("hh*16").bank("RolandTR909").gain("[.3 .45]*8").pan(sine.fast(3))
   .sometimesBy(.15, x => x.speed(1.5).gain(.6))
$: s("[~ oh]*4").bank("RolandTR909").gain(.35).mask("<0 0 1 1>/2")

// basse
$: note("<g1 g1 bb1 f1>").s("sawtooth").ftype(1)
   .struct("x ~ x ~ x ~ x ~".fast(2))
   .lpf(sine.rangex(280, 1400).slow(16)).lpq(10)
   .decay(.14).sustain(0).shape(.4)

// nappes
$: chord("<Gm9 Gm9 Bb^7 Fsus>").voicing().apply(keys)
   .clip(.9).gain(.45).room(.7).delay(.25).delaytime(3/16).delayfeedback(.5)
   .orbit(1).mask("<0 1@3>/4")

// motif
$: n("0 ~ 3 5 ~ 7 5 3".off(1/8, add(7))).scale("G4:minor")
   .s("triangle").decay(.12).sustain(0)
   .degradeBy(.35).gain(.4)
   .delay(.4).delaytime(.166).delayfeedback(.6).room(.5)
   .orbit(1).mask("<0 0 1 1>/4")
