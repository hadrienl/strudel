// Test de la banque de samples GitHub — à jeter une fois validé.
// Vérifie que raw.githubusercontent.com sert bien les fichiers au REPL (CORS + HTTPS).
setcpm(100/4)

// URL directe : marche depuis n'importe quelle branche, sans passer par strudel.json
samples({ bip: 'https://raw.githubusercontent.com/hadrienl/strudel/init-atelier/samples/test-bip/test-bip.wav' })

$: s("bip*4").gain(.5).pan("0 .35 .65 1").room(.3)
$: s("bd*4").bank("RolandTR909").gain(.7)

// Une fois la branche fusionnée dans main, la forme courte prend le relais :
// samples('github:hadrienl/strudel')
// $: s("bip*4")
