// "OH NOOOON — Générique Extended Remix" — parodie de soap 80s qui vire house
// 112 BPM — Fm/Ab, modulation en F#m pour le final — d'après Criquette Bouchard
samples({
  // le cri brut, découpé au couteau (OH / NOOON / queue)
  ohnon: 'https://raw.githubusercontent.com/hadrienl/strudel/init-atelier/samples/ohnon/ohnon.wav',
  // le même, déclaré accordé (c4 = vitesse d'origine) pour le faire chanter
  criquette: { c4: 'https://raw.githubusercontent.com/hadrienl/strudel/init-atelier/samples/ohnon/ohnon.wav' },
})

setcpm(112/4)

// ——— matière commune ———————————————————————————————————————
const prog = "<Fm9 Db^9 Ab^9 Eb7sus Fm9 Db^9 Bbm9 Eb7sus>"
const bassline = "<f1 db1 ab1 eb1 f1 db1 bb1 eb1>"

const strings = x => x.s("gm_string_ensemble_1").attack(.5).release(1.4)
  .lpf(3200).room(.8).roomsize(5).orbit(1)
const pad = x => x.s("sawtooth").attack(.7).release(1.2).sustain(.5)
  .lpf(sine.rangex(700, 2600).slow(16)).lpq(4)
  .add(note("0,.12")).room(.7).orbit(1)

// découpes du sample
const OH = x => x.begin(.10).end(.30).cut(1)   // l'attaque, en stab percussif
const NON = x => x.begin(.29).end(.87)         // la tenue, à pitcher
const TAIL = x => x.begin(.85).end(1)          // la retombée, pour la réverbe

// ——— percussions ———————————————————————————————————————————
const kit = stack(
  s("bd*4").bank("LinnDrum").gain(.95).duck(1).duckdepth(.55).duckattack(.12),
  s("~ cp ~ cp").bank("LinnDrum").room(.45).roomsize(2).gain(.5),
  s("hh*16").bank("LinnDrum").gain("[.32 .16]*8").pan(sine.fast(2).range(.35,.65)),
  s("[~ oh]*4").gain(.26),
)

$: arrange(
  // générique : un crash de cinéma, puis roulement de timbales
  [8, stack(
    s("cr").struct("x ~ ~ ~").mask("<1 0 0 0 0 0 0 1>").room(.8).gain(.4),
    note(bassline).s("gm_timpani").struct("x*8").mask("<0!6 1!2>")
      .gain(saw.range(.25,.8).fast(1)).room(.6).clip(.6),
  )],
  // montée : la boîte à rythmes 80s se met en marche
  [8, stack(
    s("~ sd ~ sd").bank("LinnDrum").room(.6).roomsize(3).roomfade(.25)
      .gain(.5).mask("<0 1>"),
    s("hh*8").bank("LinnDrum").gain("[.3 .18]*4"),
    s("lt mt ht").struct("x(3,8)").mask("<0!5 1!3>").gain(.45).room(.4),
  )],
  // drop : house de générique
  [16, kit],
  // break : tout retombe
  [8, stack(
    s("cr").struct("x ~ ~ ~").mask("<1 0 0 0 0 0 0 0>").room(.9).gain(.35),
    s("lt mt ht lt").struct("~ ~ ~ x(3,8)").mask("<0!6 1!2>").gain(.5).room(.5),
  )],
  // final : tout le monde s'y met
  [16, stack(
    kit,
    s("cr").struct("x ~ ~ ~").mask("<1 0 0 0>").room(.7).gain(.35),
    s("~ ~ ~ [sd sd sd sd]").bank("LinnDrum").mask("<0 0 0 1>").gain(.5).room(.5),
  )],
  // outro
  [4, s("cr").struct("x ~ ~ ~").mask("<1 0 0 1>").room(.9).gain(.3)],
)

// ——— basse ————————————————————————————————————————————————
$: arrange(
  [8, note(bassline).s("gm_fretless_bass").struct("x ~ ~ [~ x]")
      .mask("<0!4 1!4>").clip(.9).lpf(900).gain(.6)],
  [8, note(bassline).s("gm_fretless_bass").struct("x ~ x ~ [~ x] ~ x ~")
      .clip(.7).lpf(1100).gain(.62)],
  [16, note(bassline).s("sawtooth").struct("x*8").clip(.55)
      .lpf(sine.rangex(180, 700).slow(16)).lpq(6).decay(.14).sustain(.15)
      .shape(.35).gain(.68)],
  [8, note(bassline).s("gm_fretless_bass").struct("x ~ ~ ~").clip(1.4).lpf(700).gain(.5)],
  [16, note(bassline).add(note(1)).s("sawtooth").struct("x*8").clip(.55)
      .lpf(sine.rangex(220, 900).slow(8)).lpq(6).decay(.14).sustain(.15)
      .shape(.4).gain(.7)],
  [4, note("<f1 f1 db1 f1>").add(note(1)).s("gm_fretless_bass")
      .struct("x ~ ~ ~").clip(1.6).lpf(600).gain(.5)],
)

// ——— harmonie sirupeuse ————————————————————————————————————
$: arrange(
  [8, stack(
    chord(prog).voicing().apply(strings).struct("x@3 ~").clip(1.3).gain(.42),
    chord(prog).voicing().s("gm_piano").struct("x ~ ~ [~ x]").clip(.8)
      .room(.5).orbit(1).gain(.45),
  )],
  [8, stack(
    chord(prog).voicing().apply(strings).struct("x@3 ~").clip(1.3).gain(.45),
    chord(prog).voicing().s("gm_epiano1").struct("~ x ~ x").clip(.35)
      .delay(.3).delaytime(3/16).room(.4).orbit(1).gain(.4),
  )],
  [16, stack(
    chord(prog).voicing().apply(pad).struct("x ~ ~ ~").clip(1.6).gain(.34),
    chord(prog).voicing().s("gm_epiano1").struct("~ x ~ x ~ x ~ [x x]").clip(.22)
      .every(4, early(1/8)).delay(.25).delaytime(3/16).room(.35).orbit(1).gain(.42),
  )],
  [8, stack(
    chord(prog).voicing().apply(strings).struct("x@3 ~").clip(1.5).gain(.48),
    chord(prog).voicing().s("gm_piano").struct("x ~ [~ x] ~").clip(.7)
      .room(.6).orbit(1).gain(.42),
  )],
  [16, stack(
    chord(prog).voicing().add(note(1)).apply(strings).struct("x@3 ~").clip(1.4).gain(.48),
    chord(prog).voicing().add(note(1)).apply(pad).struct("x ~ ~ ~").clip(1.6).gain(.32),
    chord(prog).voicing().add(note(1)).s("gm_choir_aahs").struct("x ~ ~ ~")
      .clip(1.5).room(.7).orbit(1).gain(.4),
  )],
  [4, chord("<Fm9 Db^9 Eb7sus Fm9>").voicing().add(note(1)).apply(strings)
      .struct("x ~ ~ ~").clip(2).gain(.5)],
)

// ——— cloches, vibra, saxo pleurnichard —————————————————————
$: arrange(
  [8, note("<f5 ~ ab5 ~ c6 ~ eb5 ~>").s("gm_tubular_bells")
      .room(.85).roomsize(6).orbit(1).gain(.42)],
  [8, n("0 2 4 7 4 2".fast(2)).scale("<F4:minor Db4:major Ab4:major Eb4:major>")
      .s("gm_vibraphone").degradeBy(.25).clip(.5)
      .delay(.3).delaytime(3/16).room(.5).orbit(1).gain(.36)],
  [16, n("<0 4 2 7>").scale("<F5:minor Db5:major Ab5:major Eb5:major>")
      .s("gm_glockenspiel").struct("~ ~ x ~").room(.6).orbit(1).gain(.35)],
  [8, n("<[4 3] [2 ~] [1 2] [0 ~]>").scale("F4:minor").s("gm_tenor_sax")
      .clip(1.3).vib(4.5).vibmod(.25).room(.65).orbit(1).gain(.55)],
  [16, stack(
    n("<[4 3] [2 ~] [1 2] [0 ~]>").scale("F4:minor").add(note(1)).s("gm_tenor_sax")
      .clip(1.3).vib(5).vibmod(.3).room(.6).orbit(1).gain(.55),
    note("<f6 ~ ab6 ~ c6 ~ eb6 ~>").add(note(1)).s("gm_tubular_bells")
      .room(.8).orbit(1).gain(.35),
  )],
  [4, note("<f5 ~ ab5 c6>").add(note(1)).s("gm_tubular_bells")
      .struct("x ~ ~ ~").room(.95).roomsize(8).orbit(1).gain(.4)],
)

// ——— le « OH » : matière percussive ————————————————————————
$: arrange(
  [8, s("ohnon").struct("x ~ ~ ~").mask("<0 0 0 0 0 0 0 1>").apply(OH)
      .speed(.8).hpf(200).room(.9).roomsize(6).orbit(2).gain(.5)],
  [8, s("ohnon*<2 2 4 4 8 8 16 16>").apply(OH)
      .speed("<1 1 1 1.12 1.12 1.25 1.5 2>")
      .gain(saw.range(.3,.7))
      .hpf(300).room(.4).orbit(2)],
  [16, s("ohnon").struct("x ~ [x x] ~ x ~ x [~ x]").apply(OH)
      .speed("<1 1.25 1 1.5>")
      .sometimesBy(.25, ply(2)).sometimesBy(.12, x=>x.speed(2))
      .hpf(250).pan(sine.fast(3).range(.3,.7))
      .delay(.22).delaytime(3/16).delayfeedback(.3).room(.3).orbit(2).gain(.6)],
  [8, s("ohnon").struct("x ~ ~ ~").apply(TAIL).speed("<.7 .8 .6 .9>")
      .room(1).roomsize(8).delay(.4).delaytime(.375).delayfeedback(.55)
      .orbit(2).gain(.5)],
  [16, s("ohnon").struct("x ~ [x x] x ~ x [x x] x").apply(OH)
      .speed("<1.06 1.33 1.06 1.59>")
      .sometimesBy(.3, ply("<2 3>")).ply("<1 1 1 2>")
      .hpf(280).pan(rand.range(.25,.75))
      .delay(.25).delaytime(3/16).delayfeedback(.35).room(.35).orbit(2).gain(.62)],
  [4, s("ohnon").struct("x ~ ~ ~").apply(TAIL).speed("<.8 .7 .6 .5>")
      .room(1).roomsize(9).orbit(2).gain(.5)],
)

// ——— le « NOOOON » : la voix devient l'instrument ——————————
$: arrange(
  // au loin, la réplique entière, une fois toutes les quatre mesures
  [8, s("ohnon").struct("x ~ ~ ~").mask("<1 0 0 0 0 0 0 0>")
      .begin(.08).end(.92).speed(.85)
      .room(1).roomsize(9).lpf(2400).orbit(2).gain(.62)],
  [8, note("<f3 ~ ~ ~ db3 ~ c4 ~>").s("criquette").apply(NON)
      .struct("~ ~ x ~").clip(1.6).lpf(3000)
      .room(.6).roomsize(4).orbit(2).gain(.6)],
  // drop : le cri suit l'harmonie
  [16, note("<f3 db3 c4 bb3 f3 db3 db4 c4>").s("criquette").apply(NON)
      .struct("~ ~ x ~").clip(1.8)
      .every(4, x => x.struct("~ ~ [x x] ~").speed(1.02))
      .room(.5).roomsize(3).delay(.2).delaytime(3/16)
      .orbit(2).gain(.66)],
  // break : le cri à l'envers, noyé
  [8, note("<f2 ~ ab2 ~ c3 ~ db3 ~>").s("criquette").apply(NON)
      .struct("x ~ ~ ~").speed(-1).clip(2)
      .room(1).roomsize(9).lpf(1800).orbit(2).gain(.5)],
  // final : Criquette chante en accords, un demi-ton plus haut
  [16, note("<[f3,ab3,c4] [db3,f3,ab3] [c4,eb4,ab4] [bb3,db4,f4]>")
      .add(note(1)).s("criquette").apply(NON)
      .struct("~ ~ x ~").clip(1.8)
      .lastOf(4, x => x.struct("~ ~ [x x] [x ~]"))
      .room(.6).roomsize(4).delay(.25).delaytime(3/16)
      .orbit(2).gain(.45)],
  [4, note("<[f3,ab3,c4] ~ ~ [f2,f3,ab3]>").add(note(1)).s("criquette").apply(NON)
      .struct("x ~ ~ ~").clip(2.5).speed(.98)
      .room(1).roomsize(9).delay(.35).delaytime(.375).delayfeedback(.5)
      .orbit(2).gain(.45)],
)
